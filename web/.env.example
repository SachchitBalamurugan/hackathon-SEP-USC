# Copy to web/.env.local and fill in. Never commit the filled-in copy.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: lets `npm run db:migrate` (and scripts/dev.ps1) apply supabase/migrations for you.
# Supabase > Connect > Session pooler > URI, with your database password filled in.
SUPABASE_DB_URL=

# Optional. Leave empty for Claude mode: StudyLens makes no model calls and each student's own
# Claude (Claude Desktop, through the connector on Connect) checks work, answers questions and
# writes practice. Set it to have the server do that work itself instead.
ANTHROPIC_API_KEY=

# Optional: embeddings for course-material search; without it, search is full-text only
OPENAI_API_KEY=

# Where the site runs (used in pairing links and the MCP URL shown on Connect)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: a random string; Vercel cron sends it to /api/cron/consolidate
CRON_SECRET=

# Optional overrides
# MODEL_TUTOR=claude-sonnet-5-5
# MODEL_BACKGROUND=claude-haiku-5-5
# REQUIRE_EMAIL_CONFIRMATION=1
# DEMO_MODE=1   # local recording only: serves the staged Canvas API at /api/v1
